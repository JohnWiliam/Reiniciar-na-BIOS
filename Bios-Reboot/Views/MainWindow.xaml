<ui:FluentWindow x:Class="BiosReboot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BiosReboot.ViewModels"
        mc:Ignorable="d"
        Title="Confirmar Reinicialização"
        Height="250" Width="450"
        MinHeight="250" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/Assets/icon.ico"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Reiniciar na BIOS"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20,8,20,8">
            <ui:SymbolIcon Symbol="Power24"
                           FontSize="48"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <TextBlock Text="Deseja reiniciar agora e entrar na BIOS/UEFI?"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="(Firmware Setup)"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="20,4,20,18"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Content="Cancelar"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding CancelCommand}"
                       IsCancel="True"
                       HorizontalAlignment="Stretch"
                       Appearance="Secondary" />

            <ui:Button Grid.Column="2"
                       Content="Reiniciar"
                       Icon="{ui:SymbolIcon Checkmark24}"
                       Command="{Binding ConfirmRestartCommand}"
                       IsDefault="True"
                       HorizontalAlignment="Stretch"
                       Appearance="Primary" />
        </Grid>
    </Grid>
</ui:FluentWindow>
